# Shared by every backend service (compose interpolates DATABASE_URL).
DATABASE_URL=postgresql+psycopg://user:password@postgres:5432/market_data_db

# Base URLs on the Compose network. Services append the path themselves.
MARKET_DATA_SERVICE_URL=http://market-data-service:8001
MARKET_DATA_INTEGRATION_URL=http://market-data-service-integration:8005
PRICING_SERVICE_URL=http://pricing-service:8002
BOOKS_SERVICE_URL=http://books-service:8004
TRADE_ACTION_SERVICE_URL=http://trade-action-service:8080
TRADE_GENERATION_SERVICE_URL=http://trade-generation-service:8007
BLOTTER_SERVICE_URL=http://blotter-service:8006

# Root logger for all services (trading_shared.logging_config).
LOG_LEVEL=INFO

# Simulated market-data-service tick loop. Trade-generation also falls back
# to this for interval_ms when TRADE_GENERATION_INTERVAL_MS is unset.
TICK_INTERVAL_MS=500

# Trade-generation-service boot defaults. Copied into in-memory runtime
# config on start; PUT /config can change them until restart.
# false: generator books against market-data-service and OPEN_TRADE does not
# require a provider. true: generator books against
# market-data-service-integration and trade-action requires provider fields.
# The generator settings switch can change this until restart (PUT /config
# also updates trade-action via PUT /provider-mode).
USE_PROVIDER_DATA=false
TRADE_GENERATION_INTERVAL_MS=4000
TRADE_GENERATION_BATCH_SIZE=10
TRADE_GENERATION_OPEN_WEIGHT_PCT=70
TRADE_GENERATION_CLOSE_WEIGHT_PCT=30
TRADE_GENERATION_QTY_MIN=10
TRADE_GENERATION_QTY_MAX=1000
TRADE_GENERATION_PRICE_MIN=50
TRADE_GENERATION_PRICE_MAX=150

# Trade-action-service.
TRADE_ACTION_QUEUE_MAXSIZE=100
TRADE_ACTION_MAX_CLOCK_SKEW_SECONDS=5

# Pricing-service rolling book vs MARKET_INDEX window.
BOOK_METRICS_WINDOW=100

# Market-data-service-integration API keys (NBP and ECB need none).
ALPHAVANTAGE_API_KEY=[FILL ME]
FINNHUB_API_KEY=[FILL ME]
TWELVEDATA_API_KEY=[FILL ME]
FRED_API_KEY=[FILL ME]

# Quote polling / SSE stream.
MARKET_DATA_POLL_INTERVAL_SECONDS=30
# Equity symbols are polled and streamed. Pairs listed in
# MARKET_DATA_FX_SYMBOLS are removed from that set even if they also appear here.
MARKET_DATA_SYMBOLS=AAPL,MSFT,TSLA,GOOGL,AMZN,NVDA,SPY,QQQ,EURUSD,GBPUSD,USDJPY
# FX spots are not on the quote SSE stream. The trade ticket prices these
# pairs from the persisted NBP table (GET /market-data/fx-quotes).
MARKET_DATA_FX_SYMBOLS=EURUSD,GBPUSD,USDJPY
# Bond and IRS names are not on the quote SSE stream. The ticket prices them
# from persisted FRED (USD) and ECB (EUR) yield curves
# (GET /market-data/curve-quotes).
MARKET_DATA_BOND_SYMBOLS=USD_5Y,USD_10Y,EUR_10Y
MARKET_DATA_IRS_SYMBOLS=USD_5Y_IRS,USD_10Y_IRS,EUR_10Y_IRS
# Futures have no exchange feed. Each contract is SYMBOL:UNDERLYING:MULTIPLIER.
# The ticket and the pricer use the underlying equity quote as the futures price.
MARKET_DATA_FUTURES_CONTRACTS=ES:SPY:50,MES:SPY:5,NQ:QQQ:20
PROVIDER_FETCH_TIMEOUT_SECONDS=10
MARKET_DATA_MOCK_STREAM=false
MARKET_DATA_MOCK_INTERVAL_SECONDS=2

# Quote fetch audit flusher.
MARKET_DATA_AUDIT_BATCH_SIZE=10
MARKET_DATA_AUDIT_FLUSH_SECONDS=5

# Curve poll + persistence worker. Quotes poll every 30s; curves are daily-ish.
CURVE_DATA_REFRESH_INTERVAL_SECONDS=3600
MARKET_DATA_CURVE_QUEUE_MAXSIZE=1000
MARKET_DATA_CURVE_PERSIST_BATCH_SIZE=20
MARKET_DATA_CURVE_PERSIST_FLUSH_SECONDS=2.0

# Quote freshness windows shared by trade-action and pricing.
TRADE_ACTION_MAX_QUOTE_AGE_SECONDS=120
TRADE_ACTION_MAX_QUOTE_AGE_EQUITY_SECONDS=120
TRADE_ACTION_MAX_QUOTE_AGE_FX_SECONDS=60
TRADE_ACTION_MAX_QUOTE_AGE_FUTURES_SECONDS=120
TRADE_ACTION_MAX_QUOTE_AGE_OPTION_SECONDS=120
TRADE_ACTION_MAX_QUOTE_AGE_COMMODITY_SECONDS=300
TRADE_ACTION_MAX_QUOTE_AGE_BOND_SECONDS=86400
TRADE_ACTION_MAX_QUOTE_AGE_IRS_SECONDS=86400
TRADE_ACTION_MAX_QUOTE_AGE_BENCHMARK_SECONDS=86400

# Books audit purge and the shared request-body cap.
AUDIT_RETENTION_DAYS=90
AUDIT_PURGE_BATCH_SIZE=1000
AUDIT_PURGE_INTERVAL_SECONDS=86400
MAX_BODY_BYTES=1048576

# Simulated market-data persist batch.
MARKET_DATA_PERSIST_BATCH_SIZE=30

# Pricing worker.
PRICING_BASE_RECONNECT_DELAY_SECONDS=1
PRICING_MAX_RECONNECT_DELAY_SECONDS=30
PRICING_QUOTE_CONCURRENCY=8
PRICING_QUOTE_TIMEOUT_SECONDS=5
PRICING_STREAM_CONNECT_TIMEOUT_SECONDS=5
PRICING_STREAM_READ_TIMEOUT_SECONDS=30
PRICING_VALUATION_BATCH_CAP=200
PRICING_VALUATION_FLUSH_ATTEMPTS=3
PRICING_FLUSH_RETRY_SECONDS=0.5
PRICING_POLL_INTERVAL_SECONDS=5
PRICING_SSE_QUEUE_MAX=256

# Blotter.
BLOTTER_BASE_RECONNECT_DELAY_SECONDS=1
BLOTTER_MAX_RECONNECT_DELAY_SECONDS=30
BLOTTER_STREAM_TIMEOUT_SECONDS=30
BLOTTER_BOOKS_TIMEOUT_SECONDS=2
BLOTTER_JOIN_TIMEOUT_SECONDS=5
BLOTTER_MAX_VALUATIONS_PER_TRADE=20

# Monitoring probes.
MONITORING_PROBE_TIMEOUT_SECONDS=2
MONITORING_PROBE_INTERVAL_SECONDS=1
MONITORING_PROBE_TTL_SECONDS=10
MONITORING_ERROR_WINDOW_SECONDS=300

# Trade-action queue and status windows.
TRADE_ACTION_MAX_BATCH_SIZE=100
TRADE_ACTION_RECENT_ACTIONS_LIMIT=50
TRADE_ACTION_RECENT_REJECTS_LIMIT=20
TRADE_ACTION_THROUGHPUT_WINDOW_SECONDS=60
TRADE_ACTION_PRESSURE_FILL_PCT=70

# Trade-generation HTTP client and provider-mode loop floor.
TRADE_GENERATION_HTTP_TIMEOUT_SECONDS=5
TRADE_GENERATION_HTTP_CONNECT_TIMEOUT_SECONDS=2
TRADE_GENERATION_FETCH_TIMEOUT_SECONDS=2
TRADE_GENERATION_PROVIDER_MODE_TIMEOUT_SECONDS=5
TRADE_GENERATION_HTTP_MAX_CONNECTIONS=10
TRADE_GENERATION_PROVIDER_LOOP_INTERVAL_MS=15000
TRADE_GENERATION_JOIN_TIMEOUT_SECONDS=25
